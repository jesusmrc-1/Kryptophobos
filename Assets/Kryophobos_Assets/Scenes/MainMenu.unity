  m_Script: {fileID: 11500000, guid: 152ea64be4530224585bcf1efadf8c4d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  info: "Este 'GameObject' contiene los eventos del juego, como pausar el juego o
    reanudarlo, los objetos que queramos que est\xE9n al tanto de cuando se llama
    a un evento, se pueden a\xF1adir pulsando al simbolo +, luego buscas el 'GameObject'
    pulsando al simbolo del c\xEDrculo con un punto en el centro o lo arrastras al
    rect\xE1ngulo abajo de 'Runtime Only', luego en el rect\xE1ngulo de la derecha
    eliges que funci\xF3n quieres que se llame por el evento."
  OnPause:
    m_PersistentCalls:
      m_Calls: []
  OnResume:
    m_PersistentCalls:
      m_Calls: []
  OnDoingPuzzle:
    m_PersistentCalls:
      m_Calls: []
  OnNotDoingPuzzle:
    m_PersistentCalls:
      m_Calls: []
  OnFocusingPOI:
    m_PersistentCalls:
      m_Calls: []
  OnUnfocusingPOI:
    m_PersistentCalls:
      m_Calls: []
  OnPlayerDeath:
    m_PersistentCalls:
      m_Calls: []
  _slidingDoorServerRoom: {fileID: 0}
